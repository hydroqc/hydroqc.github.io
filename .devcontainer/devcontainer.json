{
	"name": "HydroQC Docs - Hugo with Docsy",
	"image": "mcr.microsoft.com/devcontainers/base:debian",
	"features": {
		"ghcr.io/devcontainers/features/hugo:1": {
			"extended": true,
			"version": "0.166.0"
		},
		"ghcr.io/devcontainers/features/go:1": {
			"version": "1.24"
		},
		"ghcr.io/devcontainers/features/node:1": {
			"version": "24"
		},
		"ghcr.io/devcontainers/features/git:1": {}
	},
	"forwardPorts": [1313],
	"portsAttributes": {
		"1313": {
			"label": "Hugo Server",
			"onAutoForward": "notify"
		}
	},
	"postCreateCommand": "curl -fsSLo /tmp/dart-sass.tar.gz https://github.com/sass/dart-sass/releases/download/1.106.1/dart-sass-1.106.1-linux-x64.tar.gz && sudo tar -xzf /tmp/dart-sass.tar.gz -C /opt && sudo ln -sf /opt/dart-sass/sass /usr/local/bin/sass && hugo mod npm pack && npm install && sudo apt-get update -qq && sudo apt-get install -y poppler-utils",
	"postStartCommand": "hugo server --bind 0.0.0.0 --disableFastRender --navigateToChanged",
	"customizations": {
		"vscode": {
			"extensions": [
				"budparr.language-hugo-vscode",
				"eliostruyf.vscode-front-matter",
				"davidanson.vscode-markdownlint"
			],
			"settings": {
				"editor.formatOnSave": true,
				"[markdown]": {
					"editor.wordWrap": "on",
					"editor.quickSuggestions": {
						"other": false,
						"comments": false,
						"strings": false
					}
				}
			}
		}
	},
	"remoteUser": "vscode"
}
